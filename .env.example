# Firebase web app config (from Firebase Console > Project settings > Your apps).
# These are safe to expose publicly — access is controlled by Firestore rules,
# Auth authorized domains, and the email allowlist below.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of Google account emails allowed to use the app.
# Leave empty to allow any signed-in Google account (NOT recommended).
# Keep this in sync with the allowlist in firestore.rules.
VITE_ALLOWED_EMAILS=maxiredigonda@gmail.com
